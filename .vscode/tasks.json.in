{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "@BUILD_PRESET@"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "flash_openocd",
            "type": "process",
            "command": "@OPENOCD_EXECUTABLE@",
            "args": [
                @OPENOCD_S_ARGS@
                "-f",
                "@OPENOCD_INTERFACE@",
                "-f",
                "@OPENOCD_TARGET@",
                "-c",
                "program ./@BUILD_OUTPUT_DIR@/output/Project.hex verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
